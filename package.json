{
  "name": "react-vue-trans-root",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:full": "pnpm --filter web build:full",
    "build:diagrams": "pnpm --filter web build:diagrams",
    "lint": "pnpm --filter web lint",
    "check:content": "pnpm --filter @repo/content check",
    "check:web-copy": "pnpm --filter web check:web-copy",
    "check:all": "pnpm run check:content && pnpm run check:web-copy",
    "dev:api": "pnpm --filter api dev",
    "dev:all": "pnpm --filter api --filter web --parallel dev",
    "smoke:api": "pnpm --filter api smoke",
    "verify:adapter": "pnpm --filter web verify:adapter",
    "verify:search-client": "pnpm --filter web verify:search-client",
    "verify:search-ui": "pnpm --filter web verify:search-ui",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "pnpm": {
    "packageExtensions": {
      "eslint-config-next": {
        "peerDependencies": {
          "next": "*"
        }
      }
    }
  }
}